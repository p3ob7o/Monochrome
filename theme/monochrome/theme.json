{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "bg",
					"color": "#0A0A0A",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "#141414",
					"name": "Surface"
				},
				{
					"slug": "surface-hover",
					"color": "#1E1E1E",
					"name": "Surface Hover"
				},
				{
					"slug": "border",
					"color": "#2A2A2A",
					"name": "Border"
				},
				{
					"slug": "text-primary",
					"color": "#E8E8E8",
					"name": "Text Primary"
				},
				{
					"slug": "text-secondary",
					"color": "#999999",
					"name": "Text Secondary"
				},
				{
					"slug": "text-muted",
					"color": "#666666",
					"name": "Text Muted"
				},
				{
					"slug": "accent",
					"color": "#D4855A",
					"name": "Accent"
				},
				{
					"slug": "accent-hover",
					"color": "#E09570",
					"name": "Accent Hover"
				}
			],
			"gradients": [],
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"customDuotone": false,
			"customGradient": false
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Space Grotesk\", system-ui, sans-serif",
					"name": "Space Grotesk",
					"slug": "space-grotesk",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/spacegrotesk/v16/V8mDoQDjQSkFtoMM3T6r8E7mPbF4Cw.woff2"
							]
						},
						{
							"fontFamily": "Space Grotesk",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/spacegrotesk/v16/V8mDoQDjQSkFtoMM3T6r8E7mPbF4Cw.woff2"
							]
						},
						{
							"fontFamily": "Space Grotesk",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/spacegrotesk/v16/V8mDoQDjQSkFtoMM3T6r8E7mPbF4Cw.woff2"
							]
						}
					]
				},
				{
					"fontFamily": "\"Source Serif 4\", Georgia, serif",
					"name": "Source Serif 4",
					"slug": "source-serif-4",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/sourceserif4/v8/vEFy2_tTDB4M7-auWDN0ahZJW3IX2ih5nk3AucvUHf6OAVIJmeUDygwjipdqpg.woff2"
							]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/sourceserif4/v8/vEFy2_tTDB4M7-auWDN0ahZJW3IX2ih5nk3AucvUHf6OAVIJmeUDygwjipdqpg.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"size": "0.75rem",
					"name": "Extra Small"
				},
				{
					"slug": "sm",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "base",
					"size": "1rem",
					"name": "Base"
				},
				{
					"slug": "lg",
					"size": "1.125rem",
					"name": "Large"
				},
				{
					"slug": "xl",
					"size": "1.25rem",
					"name": "Extra Large"
				},
				{
					"slug": "2xl",
					"size": "1.75rem",
					"name": "2X Large"
				},
				{
					"slug": "3xl",
					"size": "2.5rem",
					"name": "3X Large"
				},
				{
					"slug": "4xl",
					"size": "3.5rem",
					"name": "4X Large"
				}
			],
			"customFontSize": true,
			"defaultFontSizes": false,
			"lineHeight": true,
			"letterSpacing": true
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "1", "size": "0.25rem", "name": "1" },
				{ "slug": "2", "size": "0.5rem", "name": "2" },
				{ "slug": "3", "size": "0.75rem", "name": "3" },
				{ "slug": "4", "size": "1rem", "name": "4" },
				{ "slug": "6", "size": "1.5rem", "name": "6" },
				{ "slug": "8", "size": "2rem", "name": "8" },
				{ "slug": "12", "size": "3rem", "name": "12" },
				{ "slug": "16", "size": "4rem", "name": "16" },
				{ "slug": "24", "size": "6rem", "name": "24" },
				{ "slug": "32", "size": "8rem", "name": "32" }
			],
			"units": [ "px", "rem", "em", "vh", "vw", "%" ],
			"defaultSpacingSizes": false
		},
		"border": {
			"color": true,
			"radius": false,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false
		},
		"custom": {
			"contentMaxWidth": "800px",
			"galleryMaxWidth": "1200px",
			"heroMaxWidth": "1400px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--color-bg)",
			"text": "var(--color-text-primary)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--source-serif-4)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--6)",
			"padding": {
				"left": "var(--wp--preset--spacing--4)",
				"right": "var(--wp--preset--spacing--4)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--color-accent)"
				},
				":hover": {
					"color": {
						"text": "var(--color-accent-hover)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				"typography": {
					"textDecoration": "none"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "500",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var(--color-text-primary)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--3-xl)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--2-xl)",
					"lineHeight": "1.3"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)",
					"lineHeight": "1.4"
				}
			},
			"button": {
				"color": {
					"background": "var(--color-accent)",
					"text": "#FFFFFF"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontSize": "var(--wp--preset--font-size--sm)",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				},
				"border": {
					"radius": "2px"
				},
				":hover": {
					"color": {
						"background": "var(--color-accent-hover)"
					}
				}
			}
		},
		"blocks": {
			"core/image": {
				"border": {
					"radius": "0"
				}
			},
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.7"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-home",
			"title": "Homepage",
			"postTypes": [ "page" ]
		},
		{
			"name": "single-photo",
			"title": "Photo Detail",
			"postTypes": [ "post" ]
		},
		{
			"name": "page-blog",
			"title": "Blog Listing",
			"postTypes": [ "page" ]
		}
	]
}
